# Frontend (Next.js). Sao chép thành .env.local.
# URL gốc của site (canonical / sitemap / Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# URL server API (project api/ riêng)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Analytics nhẹ (Plausible). Để trống = tắt. Ví dụ production: "googlesnakemods.com"
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
